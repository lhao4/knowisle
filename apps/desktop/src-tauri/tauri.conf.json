{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KnowIsle",
  "version": "0.1.0",
  "identifier": "dev.knowisle.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "知屿 KnowIsle",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "KnowIsle",
    "homepage": "https://github.com/lhao4/knowisle",
    "copyright": "Copyright (c) 2026 KnowIsle contributors",
    "license": "AGPL-3.0-or-later",
    "category": "Productivity",
    "shortDescription": "本地优先的 Markdown 知识库",
    "longDescription": "知屿 KnowIsle 把笔记存成磁盘上普通的 .md 文件，索引只是可以随时重建的派生物。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
