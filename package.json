{
  "name": "knowisle",
  "version": "0.1.0",
  "private": true,
  "description": "知屿 KnowIsle · 把知识，安放在自己的岛上。",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @knowisle/desktop tauri dev",
    "build": "pnpm --filter @knowisle/desktop tauri build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "check": "cargo check --workspace",
    "test": "cargo test --workspace"
  }
}
