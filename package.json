{
  "name": "knowisle",
  "version": "0.1.0",
  "private": true,
  "description": "知屿 KnowIsle · 把知识，安放在自己的岛上。",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @knowisle/desktop tauri dev",
    "build": "pnpm --filter @knowisle/desktop tauri build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "bindings": "pnpm --filter @knowisle/desktop bindings:generate",
    "bindings:check": "pnpm --filter @knowisle/desktop bindings:check",
    "check": "cargo check --workspace",
    "test": "pnpm --filter @knowisle/desktop test && cargo test --workspace",
    "test:web": "pnpm --filter @knowisle/desktop test",
    "test:rust": "cargo test --workspace",
    "e2e:trash": "node scripts/e2e/cdp-trash.mjs",
    "e2e:trash-restore": "node scripts/e2e/cdp-trash-restore.mjs",
    "e2e:trash-page": "node scripts/e2e/cdp-trash-page.mjs",
    "e2e:tree": "node scripts/e2e/cdp-tree.mjs",
    "e2e:outline": "node scripts/e2e/cdp-outline.mjs",
    "e2e:keys": "node scripts/e2e/cdp-keys.mjs",
    "e2e:theme": "node scripts/e2e/cdp-theme.mjs",
    "e2e:encoding-batch": "node scripts/e2e/cdp-encoding-batch.mjs",
    "e2e:external": "node scripts/e2e/cdp-external-change.mjs",
    "e2e:skip-list": "node scripts/e2e/cdp-skip-list.mjs",
    "e2e:ignore-rules": "node scripts/e2e/cdp-ignore-rules.mjs",
    "e2e:all": "node scripts/e2e/all.mjs"
  }
}
